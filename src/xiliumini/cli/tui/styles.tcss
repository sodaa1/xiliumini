$background: #07111f;
$surface: #0d1b2a;
$panel-bg: #102438;
$accent: #20d6d0;
$brand-blue: #2796ff;
$brand-orange: #ff812b;
$muted: #7890a8;

Screen {
    background: $background;
    color: #d8e7f3;
}

Header {
    background: $surface;
    color: $accent;
}

#main {
    width: 100%;
    height: 1fr;
    padding: 0 2 1 2;
}

#brand-row {
    width: 100%;
    height: 7;
}

#brand-row.conversation-started {
    height: 1;
}

#logo {
    width: 100%;
    height: 6;
    padding-top: 0;
    text-align: center;
    content-align: center middle;
}

#logo.collapsed {
    display: none;
}

#status-bar {
    width: 100%;
    height: 1;
    color: $muted;
    text-align: right;
}

#conversation {
    width: 100%;
    height: 1fr;
    padding: 1 0;
    scrollbar-color: #27445f $background;
    scrollbar-color-hover: $brand-blue $background;
    scrollbar-color-active: $accent $background;
}

.conversation-turn {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.turn-user {
    width: 100%;
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

.turn-thinking {
    width: 100%;
    height: auto;
    margin: 0 1 1 1;
    color: $muted;
    background: $surface;
}

.turn-thinking CollapsibleTitle {
    color: $muted;
    padding: 0 1;
}

.turn-thinking Contents {
    padding: 0;
    background: $surface;
}

.turn-reasoning-scroll {
    width: 100%;
    height: 12;
    padding: 0 1 1 2;
    background: $surface;
    scrollbar-color: #27445f $surface;
}

.turn-reasoning-content {
    width: 100%;
    height: auto;
    color: #a9bed0;
    background: $surface;
}

.turn-answer {
    width: 100%;
    height: auto;
    padding: 0 1 1 1;
    color: #d8e7f3;
    background: $background;
}

.turn-answer.empty {
    display: none;
}

#prompt {
    width: 100%;
    height: 3;
    margin-top: 1;
    border: round $accent;
    background: $surface;
}

ApprovalModal {
    align: center middle;
    background: rgba(3, 9, 18, 0.78);
}

#approval-dialog {
    width: 92%;
    max-width: 88;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $brand-orange;
    background: $surface;
}

#approval-title {
    width: 100%;
    color: $brand-orange;
    text-style: bold;
    content-align: center middle;
    margin-bottom: 1;
}

#approval-command {
    width: 100%;
    max-height: 12;
    padding: 1;
    margin: 1 0;
    border: round #27445f;
    background: $background;
}

#approval-actions {
    width: 100%;
    height: auto;
    align-horizontal: center;
}

#approval-actions Button {
    margin: 0 1;
}
