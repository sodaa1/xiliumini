XILIUMINI_API_KEY=
TAVILY_API_KEY=
XILIUMINI_MODEL=
# Optional comma-separated fallback order:
XILIUMINI_MODELS=
XILIUMINI_BASE_URL=
XILIUMINI_TEMPERATURE=0
XILIUMINI_TIMEOUT_SECONDS=60
XILIUMINI_ANALYSIS_TIMEOUT_SECONDS=30
XILIUMINI_ANALYSIS_MAX_CHARS=8000
# Planner Memory compression: trigger at 80% of a 64k context and keep newest 8k tokens.
XILIUMINI_CONTEXT_WINDOW_TOKENS=64000
XILIUMINI_COMPRESSION_TRIGGER_RATIO=0.8
XILIUMINI_COMPRESSION_KEEP_TOKENS=8000
XILIUMINI_DATA_DIR=.xiliumini
# Harness persistence modes: light/strict/off and full/summary/off.
XILIUMINI_CHECKPOINT_MODE=light
XILIUMINI_TRACE_MODE=full
# Optional unique ID for a single run; omit to generate one automatically.
# XILIUMINI_TRACE_ID=my-run
